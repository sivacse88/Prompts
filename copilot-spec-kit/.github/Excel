=IF(D2="Past Due","Past Due",IF(ISNUMBER(D2),D2,IFERROR(DATEVALUE(D2),"")))
=IF(COUNTIF(TLM!$A:$A,B2)=0,"N/A",
 IF(COUNTIFS(TLM!$A:$A,B2,TLM!$E:$E,"Past Due")>0,"Past Due",
 MINIFS(TLM!$E:$E,TLM!$A:$A,B2)))

=IF(COUNTIF(TLM!$A:$A,B2)=0,"Current",
 IF(COUNTIFS(TLM!$A:$A,B2,TLM!$E:$E,"Past Due")>0,"End of Life",
 IF(MINIFS(TLM!$E:$E,TLM!$A:$A,B2)<TODAY(),"End of Life",
 IF(MINIFS(TLM!$E:$E,TLM!$A:$A,B2)<=TODAY()+90,"Approaching EOL","Current"))))


=IF(OR(M2="N/A",M2="Past Due"),"",M2-TODAY())



