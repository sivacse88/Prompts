{
  "name": "Portfolio Health",
  "dataColors": [
    "#1F3A5F", "#3F6E9A", "#7FA7C9", "#B9D0E3",
    "#4E8A6E", "#8DBBA3", "#9AA3AD", "#D5D9DE"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D5B",
  "neutral": "#E0A31A",
  "bad": "#C0392B",
  "maximum": "#C0392B",
  "center": "#F6C9C4",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout":  { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title":    { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header":   { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6670" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border":      [{ "show": false }],
        "dropShadow":  [{ "show": false }],
        "background":  [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "visualHeader":[{ "show": true }],
        "padding":     [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#1F2933" } }, "fontSize": 28 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#5B6670" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#5B6670" } }, "textSize": 9 }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E6E9EC" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E6E9EC" } } }]
      }
    }
  }
}
